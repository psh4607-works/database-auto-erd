FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate
WORKDIR /app
COPY . .
# Git hooks already run on the host; the build context deliberately contains no .git.
# Lifecycle outputs needed by the app are generated by the build below.
RUN --mount=type=cache,id=database-auto-erd-pnpm,target=/pnpm/store pnpm install --frozen-lockfile --ignore-scripts --store-dir /pnpm/store
ENV ERD_LOCAL_ONLY=1 NEXT_TELEMETRY_DISABLED=1 GIT_HASH=local
RUN pnpm --filter @liam-hq/schema gen && pnpm --filter @liam-hq/schema build
RUN pnpm create-env-files && pnpm exec turbo run gen --filter=@liam-hq/app... && pnpm --filter @liam-hq/app build

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production ERD_LOCAL_ONLY=1 NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
ENV ERD_DATA_DIR=/data ERD_KEY_FILE=/run/secrets/credential_key
WORKDIR /app
COPY --from=build /app/frontend/apps/app/.next/standalone ./
COPY --from=build /app/frontend/apps/app/.next/static ./frontend/apps/app/.next/static
COPY --from=build /app/frontend/apps/app/public ./frontend/apps/app/public
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 3000
CMD ["node", "frontend/apps/app/server.js"]
